# NetPulse environment variables
# Copy to .env and fill in as needed. None are required for the current scope;
# they are listed here so the contract is documented as it grows.

# Where DuckDB files and raw data dumps live (CLI commands default --out
# beneath this directory once a project-level default is wired up).
NETPULSE_DATA_DIR=./data

# Logging level: DEBUG, INFO, WARNING, ERROR
NETPULSE_LOG_LEVEL=INFO
